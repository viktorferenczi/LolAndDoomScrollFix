<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lehetővé teszi a Windows-célú projektek fordítását macOS/Linux alatt is (CI, ellenőrzés). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>LolScrollLimiter</Company>
    <Product>LoL- és görgetéskorlátozó</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
