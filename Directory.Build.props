<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Allows compiling the Windows-targeting projects on macOS/Linux too (CI, checks). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>LolScrollLimiter</Company>
    <Product>LoL &amp; Doomscroll Limiter</Product>
    <Version>1.6.1</Version>
  </PropertyGroup>
</Project>
