{
  "manifest_version": 3,
  "name": "LoL- és görgetéskorlátozó",
  "version": "1.0.0",
  "description": "Rövidvideós és Facebook-hírfolyam időkeret (60-60 perc / 24 óra) a helyi korlátozó szolgáltatással.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.youtube.com/*",
        "https://*.facebook.com/*"
      ],
      "js": [
        "detect.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LoL- és görgetéskorlátozó",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed"
}
